youtube-downloader.org, www.youtube-downloader.org {
    encode gzip zstd

    @api path /api/* /files/* /health
    handle @api {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}
